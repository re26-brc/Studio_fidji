<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE RSyntaxTheme SYSTEM "theme.dtd">

<!--
	Updated theme for better readability, contrast, and modern appearance.
	Based on best practices for UI design and accessibility.
-->
<RSyntaxTheme version="1.0">

   <!-- Using a modern, widely available font with increased size -->
   <baseFont family="JetBrains Mono, Consolas, Menlo, Monaco, 'DejaVu Sans Mono', monospace" size="14"/>
   
   <!--  General editor colors with improved contrast -->
   <background color="FFFFFF"/>
   <caret color="000000"/>
   <selection bg="4D97FF" fg="FFFFFF"/>
   <currentLineHighlight color="F0F5FF" fade="false"/>
   <marginLine fg="9DA5B4"/>
   <markAllHighlight color="A6CFD8"/> 
   <markOccurrencesHighlight color="E0E0E0" border="false"/>
   <matchedBracket fg="2196F3" highlightBoth="true" animate="true"/>
   <hyperlinks fg="2196F3"/>
   <secondaryLanguages>
      <language index="1" bg="FFF8E1"/>
      <language index="2" bg="E8F5E9"/>
      <language index="3" bg="F3E5F5"/>
   </secondaryLanguages>
   
   <!-- Gutter styling with improved contrast -->
   <gutterBorder color="E0E0E0"/>
   <lineNumbers fg="616161"/>
   <foldIndicator fg="616161" iconBg="FFFFFF"/>
   <iconRowHeader activeLineRange="2196F3"/>
   
   <!-- Syntax tokens with improved contrast and readability -->
   <tokenStyles>
      <style token="IDENTIFIER" fg="000000"/>
      <style token="RESERVED_WORD" fg="7E57C2" bold="true"/>
      <style token="RESERVED_WORD_2" fg="7E57C2" bold="true"/>
      <style token="ANNOTATION" fg="C2185B"/>
      <style token="COMMENT_DOCUMENTATION" fg="3F51B5"/>
      <style token="COMMENT_EOL" fg="388E3C"/>
      <style token="COMMENT_MULTILINE" fg="388E3C"/>
      <style token="COMMENT_KEYWORD" fg="3F51B5" bold="true"/>
      <style token="COMMENT_MARKUP" fg="5C6BC0"/>
      <style token="DATA_TYPE" fg="C2185B" bold="true"/>
      <style token="FUNCTION" fg="0277BD"/>
      <style token="LITERAL_BOOLEAN" fg="7E57C2" bold="true"/>
      <style token="LITERAL_NUMBER_DECIMAL_INT" fg="F57C00"/>
      <style token="LITERAL_NUMBER_FLOAT" fg="F57C00"/>
      <style token="LITERAL_NUMBER_HEXADECIMAL" fg="F57C00"/>
      <style token="LITERAL_STRING_DOUBLE_QUOTE" fg="2E7D32"/>
      <style token="LITERAL_CHAR" fg="2E7D32"/>
      <style token="LITERAL_BACKQUOTE" fg="2E7D32"/>
      <style token="MARKUP_TAG_DELIMITER" fg="0097A7"/>
      <style token="MARKUP_TAG_NAME" fg="00838F"/>
      <style token="MARKUP_TAG_ATTRIBUTE" fg="D81B60"/>
      <style token="MARKUP_TAG_ATTRIBUTE_VALUE" fg="2E7D32" italic="true"/>
      <style token="MARKUP_COMMENT" fg="3F51B5"/>
      <style token="MARKUP_DTD" fg="0097A7"/>
      <style token="MARKUP_PROCESSING_INSTRUCTION" fg="616161"/>
      <style token="MARKUP_CDATA" fg="000000"/>
      <style token="MARKUP_CDATA_DELIMITER" fg="0097A7"/>
      <style token="MARKUP_ENTITY_REFERENCE" fg="2E7D32"/>
      <style token="OPERATOR" fg="1565C0"/>
      <style token="PREPROCESSOR" fg="616161"/>
      <style token="REGEX" fg="00695C"/>
      <style token="SEPARATOR" fg="1565C0"/>
      <style token="VARIABLE" fg="7E57C2" bold="false"/>
      <style token="WHITESPACE" fg="000000"/>
      
      <style token="ERROR_IDENTIFIER" fg="FFFFFF" bg="F44336"/>
      <style token="ERROR_NUMBER_FORMAT" fg="FFFFFF" bg="F44336"/>
      <style token="ERROR_STRING_DOUBLE" fg="FFFFFF" bg="F44336"/>
      <style token="ERROR_CHAR" fg="FFFFFF" bg="F44336"/>
   </tokenStyles>

</RSyntaxTheme>